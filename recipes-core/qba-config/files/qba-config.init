#!/bin/sh
### BEGIN INIT INFO
# Provides:          qba-config
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: apply the stored configuration
### END INIT INFO

case "$1" in
    start)
        /usr/sbin/qba-config boot
        ;;
    stop)
        sync
        ;;
    status)
        /usr/sbin/qba-config status
        ;;
    restart|force-reload)
        ;;
    *)
        echo "usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
exit 0
